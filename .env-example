# Prisma

DATABASE_URL=https://fake.com

# Knock notifications

KNOCK_SIGNING_KEY=1
NEXT_PUBLIC_KNOCK_PUBLIC_KEY=1

# Mainenance mode flag

NEXT_PUBLIC_OFFLINE=0

# Next Auth

NEXTAUTH_SECRET=1
NEXTAUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=1
DISCORD_CLIENT_SECRET=1
GOOGLE_CLIENT_ID=1
GOOGLE_CLIENT_SECRET=1
GOOGLE_CLIENT_SECRET=1
TWITCH_CLIENT_ID=1
TWITCH_CLIENT_SECRET=1
EMAIL_SERVER=1
EMAIL_FROM=1
